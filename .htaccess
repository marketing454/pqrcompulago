Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<FilesMatch "^\.env(?:\..*)?$">
    Require all denied
</FilesMatch>

<FilesMatch "^(?:Dockerfile|docker-compose(?:\..*)?|.*\.(?:sql|ya?ml|ini|log|txt|xlsx|lock))$">
    Require all denied
</FilesMatch>

RewriteEngine On
RewriteRule ^(?:docker|includes|vendor|storage)(?:/|$) - [F,L,NC]
